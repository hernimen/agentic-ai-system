LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text

CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=lims_sops
SOPS_SOURCE_DIRS=["./data/sops", "./data/equipment_manuals"]

CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVER_K=2
RETRIEVER_SCORE_THRESHOLD=0.0
BM25_WEIGHT=0.5
VECTOR_WEIGHT=0.5

QUERY_REWRITING_ENABLED=true
QUERY_REWRITING_STRATEGY=multi_query
QUERY_REWRITING_NUM_VARIANTS=3

RERANKING_ENABLED=false
RERANKER_TOP_K=5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lims-sop-agent
LOG_LEVEL=INFO